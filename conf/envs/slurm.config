process {
    
    // standard settings if not specified otherwise
    
    executor = 'slurm'
    clusterOptions = "--qos=30min"
    errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
    maxRetries = 0
    time = { 10.m * task.attempt }
    memory = { 4.GB * task.attempt }
    cpus = 4
    queueSize = 20
    maxForks = 80
    
    // general estimates for groups of processes
    
    withLabel: star {
        clusterOptions = "--qos=6hours"
        cpus = 8
        time = { 2.h * task.attempt }
        memory = { 40.GB * task.attempt }
    }
    withLabel: samtools {
        clusterOptions = "--qos=6hours"
        cpus = 8
        time = { 2.h * task.attempt }
        memory = { 40.GB * task.attempt }
    }
    withLabel: bedtools {
        cpus = 8
        memory = { 8.GB * task.attempt }
    }
    withLabel: TECtool {
        clusterOptions = { task.attempt > 1 ? "--qos=1day" : "--qos=6hours" }
        cpus = 8
        time = { 6.h * task.attempt }
        memory = { 64.GB * task.attempt }
    }
    withLabel: calculate_tin {
        clusterOptions = "--qos=6hours"
        cpus = 8
        time = { 3.h * task.attempt }
        memory = 32.GB
    }
    withLabel: salmon {
        clusterOptions = "--qos=6hours"
        cpus = 8
        time = { 2.h * task.attempt }
    }
    withLabel: intron_retention {
        clusterOptions = "--qos=6hours"
        memory = { 32.GB * task.attempt }
        time = { 1.h * task.attempt }
    }

    // Specific requirements
    
    withName: SAMTOOLS_GET_LOW_DUP_READS {
        clusterOptions = "--qos=6hours"
        cpus = 8
        memory = { 40.GB * task.attempt }
        time = { 2.h * task.attempt }
    }
}
